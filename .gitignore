node_modules/
dist/
out/
# The root build/ folder holds the mac entitlements, which are SOURCE, not
# build output - a blanket build/ ignore silently swallowed them once and
# broke every mac package at codesign. Ignoring the CONTENTS (not the folder)
# lets the carve-out below work; git never descends into an ignored folder.
/build/*
!/build/entitlements.mac.plist
apps/desktop/native/camera-effects/build/
release/
*.log
.DS_Store
.env
.env.*
*.local
coverage/
test-results/
playwright-report/
tmp/
.vite/
*.tsbuildinfo
data/
test-assets/
.tmp/


# Local render sources for the release videos (published as release assets)
docs/media/new-videos/
docs/media/open-loom-facefirst.mp4

# Self-hosted share server data dir - writes a live api-key.txt
openloom-data/
*.bak

# Per-install marker for the weekly update check (see AGENTS.md). Never shared.
.openloom-update-check
.openloom-pre-update
