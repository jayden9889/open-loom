{
  "name": "openloom-desktop",
  "productName": "OpenLoom",
  "version": "0.1.5",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Open Loom desktop app: local-first screen recorder with Loom-parity UX.",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.preload.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --config electron-builder.yml",
    "postdist": "node -e \"for (const d of ['mac','mac-arm64','mac-universal']) require('fs').rmSync('../../release/'+d,{recursive:true,force:true})\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "electron-audio-loopback": "^1.0.6",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "nanoid": "^5.1.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "optionalDependencies": {
    "openloom-camera-effects": "file:./native/camera-effects",
    "uiohook-napi": "^1.5.5"
  },
  "author": {
    "name": "Jayden Mortimer",
    "email": "jayden@mortaihq.com"
  },
  "homepage": "https://github.com/jayden9889/open-loom",
  "desktopName": "open-loom.desktop"
}
